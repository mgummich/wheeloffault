{
  "name": "schuldrad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Selbst gehostetes Schuldrad: Wer ist diesmal schuldig?",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:full": "concurrently -k \"pnpm dev:server\" \"pnpm dev:web --mode server\"",
    "dev:server": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "vite build && node scripts/build-docs.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:server": "vite build --mode server",
    "start": "node src/server/main.ts",
    "verify:draw": "node scripts/verify-draw.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm build",
    "e2e": "playwright test",
    "status": "node scripts/status.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "fast-check": "^4.10.3",
    "marked": "^18.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.24.0"
}
